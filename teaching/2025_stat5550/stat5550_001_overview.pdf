dup 108 /l put
dup 110 /n put
dup 111 /o put
dup 49 /one put
dup 40 /parenleft put
dup 41 /parenright put
dup 114 /r put
dup 115 /s put
dup 116 /t put
dup 50 /two put
dup 117 /u put
dup 122 /z put
dup 48 /zero put
readonly def
currentdict end
currentfile eexec
