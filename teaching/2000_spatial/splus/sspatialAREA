$call:
twoway.formula(formula = ore ~ easting + northing, data = iron.ore)

# calculate the predicted data

iron.pred _ iron.ore$ore - iron.mp$residuals

# convert vectors to matrices, determine range of both matrices,
# and plot original data and predicted data

iron.mat _ tapply(iron.ore$ore, 
             list(iron.ore$easting, iron.ore$northing),
             function(x) x
           )

iron.predmat _ tapply(iron.pred, 
             list(iron.ore$easting, iron.ore$northing),
             function(x) x
           )

iron.resmat _ tapply(iron.mp$residuals, 
             list(iron.ore$easting, iron.ore$northing),
             function(x) x
           )

zmin _ min(iron.mat, iron.predmat, na.rm = T)
zmax _ max(iron.mat, iron.predmat, na.rm = T)
zminres _ min(iron.resmat, na.rm = T)
zmaxres _ max(iron.resmat, na.rm = T)

par(mfrow = c(2, 2), pty = "s")
image(iron.mat, zlim = c(zmin, zmax), main = "Observed")
image(iron.predmat, zlim = c(zmin, zmax), main = "Predicted")
image(iron.resmat, zlim = c(zminres, zmaxres), main = "Residuals")

