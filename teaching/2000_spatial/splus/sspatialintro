Simulation envelopes:

quakes.spp _ spp (quakes.bay)

par (mfrow = c(1, 1))
quakes.khat _ Khat (quakes.spp, plot = F)
plot (quakes.khat$values[quakes.khat$values[,1] < 0.5, ])
title ("Khat and Simulation Envelopes")

quakes.kenv _ Kenv (quakes.spp, nsims = 4, add = F)
quakes.index _ quakes.kenv$dist < 0.5
lines (quakes.kenv$dist[quakes.index], quakes.kenv$lower[quakes.index])
lines (quakes.kenv$dist[quakes.index], quakes.kenv$upper[quakes.index])

(quakes.kenv$upper[quakes.index] - quakes.kenv$lower[quakes.index])[1:10]

