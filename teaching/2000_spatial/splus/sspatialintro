Dealing with nearest neighbor distances:

xmin _ min (bbox(quakes.spp)$x)
xmax _ max (bbox(quakes.spp)$x)
ymin _ min (bbox(quakes.spp)$y)
ymax _ max (bbox(quakes.spp)$y)

quakes.ext _ matrix (c(xmin, xmax, quakes.spp$longitude, 
   ymin, ymax, quakes.spp$latitude), 2051, 2)

quakes.neighbors _ find.neighbor (quakes.ext, k = 2)
quakes.neighbors[1:10,]

#   index1 index2  distances 
# 1      1    760 1.14109596
# 2      1      1 0.00000000
# 3      2   1561 1.61969133
# 4      2      2 0.00000000
# 5      3    815 0.10000000
# 6      3      3 0.00000000
# 7      4    292 0.03162278
# 8      4      4 0.00000000
# 9      5   1803 0.03162278
#10      5      5 0.00000000

nrow(quakes.neighbors)
# [1] 4102

plot (quakes.spp)
lines (c(xmin, quakes.spp$longitude[quakes.neighbors[1,2] - 2]),
       c(ymin, quakes.spp$latitude[quakes.neighbors[1,2] - 2]) )
lines (c(xmax, quakes.spp$longitude[quakes.neighbors[3,2] - 2]),
       c(ymax, quakes.spp$latitude[quakes.neighbors[3,2] - 2]) )

quakes.diff _ quakes.neighbors[quakes.neighbors[,3] > 0, ]
nrow(quakes.diff)
# [1] 1067

quakes.diff2 _ quakes.neighbors[quakes.neighbors[,1] != quakes.neighbors[,2], ]
