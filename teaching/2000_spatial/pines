2) ghat.env function from Kaluzny et al...

ghat.env _ function (n, s, dist, 
  boundary = bbox(x = c(0,1), y = c(0,1)))
{
  hold _ matrix(0, s, length(dist))
  for (i in 1:s)
  {
    hold[i, ] _ Ghat(make.pattern(n, boundary = boundary), 
      dist.ghat = dist, plot = F)[,2]
  }

  mn _ apply(hold, 2, mean)
  Up _ apply(hold, 2, max)
  Down _ apply(hold, 2, min)
  return(data.frame(mn, Up, Down))
}


