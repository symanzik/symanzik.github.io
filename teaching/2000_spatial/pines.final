1) Reading in the Data and Creating a SPP:

pines _ matrix( scan ("/home/symanzik/splus/pines.dat"), 71, 2, byrow = T)
pines.spp _ spp (pines / 10, boundary = bbox(x = c(0, 10), y = c(0, 10)))
summary (pines.spp)


2) ghat.env function from Kaluzny et al...

ghat.env _ function (n, s, dist, 
  boundary = bbox(x = c(0,1), y = c(0,1)))
{
  hold _ matrix(0, s, length(dist))
  for (i in 1:s)
  {
    hold[i, ] _ Ghat(make.pattern(n, boundary = boundary), 
      dist.ghat = dist, plot = F)[,2]
  }

  mn _ apply(hold, 2, mean)
  Up _ apply(hold, 2, max)
  Down _ apply(hold, 2, min)
  return(data.frame(mn, Up, Down))
}


3) Simple Plot: Figure 8.7 (a) in Ripley

par (mfrow = c(2,4))
par (pty = "s")
plot (pines.spp, main = "Pine Trees")


4) Lhat and envelopes: Figure 8.7 (c) in Ripley

pines.lhat _ Lhat (pines.spp)
title ("Lhat")
abline(0, 1)

pines.env _ Lenv (pines.spp, nsims = 50, process = "binomial", 
  boundary = bbox(x = c(0, 10), y = c(0, 10)))

# concentrate on interval from 0.0 to 2.0

pines.hatdist _ pines.lhat$values[,1] < 2.0
plot (pines.lhat$values[pines.hatdist,])
title ("Lhat in [0.0, 2.0]")
lines (pines.env$dist[pines.hatdist], 
  pines.env$upper[pines.hatdist])
lines (pines.env$dist[pines.hatdist], 
  pines.env$lower[pines.hatdist])
abline(0, 1)


5) Nearest Neighbor Plot Ghat and envelopes: should be Figure 8.7 (d) in Ripley

pines.ghat _ Ghat (pines.spp, plot = F)

pines.sdist = seq(0.0, 1.6, by = 0.05)

pines.genv _ ghat.env (n = 71, s = 100, pines.sdist,
  boundary = bbox(x = c(0, 10), y = c(0, 10)))

plot (c(0, 1.6), c(0, 1.0), xlab = "distance", ylab = "Ghat", type = "n")
title ("Ghat in [0.0, 1.6]")
points (pines.ghat)
lines (pines.sdist, pines.genv$Up, lty = 2)
lines (pines.sdist, pines.genv$Down, lty = 2)


6) Strauss process - Simple Plot

pines.strauss _ make.pattern (71, process = "Strauss", 
  radius = 0.7, cpar = 0.2, boundary = bbox(x = c(0, 10), y = c(0, 10)))

plot(pines.strauss)


7) Strauss process - Lhat and envelopes: Figure 8.7 (e) in Ripley

pines.strlhat _ Lhat (pines.strauss)
pines.strkenv _ Lenv (pines.strauss, nsims = 50, process = "Strauss", 
  radius = 0.7, cpar = 0.2, boundary = bbox(x = c(0, 10), y = c(0, 10)))
title ("Lhat for Strauss")

# concentrate on interval from 0.0 to 2.0

pines.strhatdist _ pines.strlhat$values[,1] < 2.0
plot (pines.strlhat$values[pines.strhatdist,])
title ("Lhat for Strauss in [0.0, 2.0]")
lines (pines.strkenv$dist[pines.strhatdist], 
  pines.strkenv$upper[pines.strhatdist])
lines (pines.strkenv$dist[pines.strhatdist], 
  pines.strkenv$lower[pines.strhatdist])
