Writing Functions:

myrexp _ function (mu, num = 1)
{
 cat ("This is my random function based on Inversion.\n", fill = T)
 cat ("Calculating random value(s) from exponential with mu = ")
 print (mu)
 cat ("", fill = T)
 cat ("That's all the text !", fill = T)

 -mu * log (runif(num))
}


