%%BeginDocument: /local/mnt/gis4/majure/Santa_Fe/BrushedVario.ps
%!PS-Adobe-2.0 EPSF-2.0
%%Title: BrushedVario.ps
%%Creator: XV Version 2.21  Rev: 4/29/92  -  by John Bradley
%%BoundingBox: 0 0 278 352
%%Pages: 1
%%DocumentFonts:
%%EndComments
%%EndProlog

%%Page: 1 1

% remember original state
/origstate save def

% build a temporary dictionary
20 dict begin

% define string to hold a scanline's worth of data
/pix 1572 string def

% we're going to a 4x5 or a 35mm film recorder.
% clear page to black to avoid registration problems
newpath
  0 0 moveto
  0 351 rlineto
  279 0 rlineto
  0 -351 rlineto
  closepath
  0 setgray
  fill

% lower left corner
0 0 translate

% size of image (on paper, in 1/72inch coords)
278 352 scale

% define 'colorimage' if it isn't defined
%   ('colortogray' and 'mergeprocs' come from xwd2ps
%     via xgrab)
/colorimage where   % do we know about 'colorimage'?
  { pop }           % yes: pop off the 'dict' returned
  {                 % no:  define one
    /colortogray {  % define an RGB->I function
      /rgbdata exch store    % call input 'rgbdata'
      rgbdata length 3 idiv
      /npixls exch store
      /rgbindx 0 store
      /grays npixls string store  % str to hold the result
      0 1 npixls 1 sub {
        grays exch
        rgbdata rgbindx       get 20 mul    % Red
        rgbdata rgbindx 1 add get 32 mul    % Green
        rgbdata rgbindx 2 add get 12 mul    % Blue
        add add 64 idiv      % I = .5G + .31R + .18B
        put
        /rgbindx rgbindx 3 add store
      } for
      grays
    } bind def

    % Utility procedure for colorimage operator.
    % This procedure takes two procedures off the
    % stack and merges them into a single procedure.

    /mergeprocs { % def
      dup length
      3 -1 roll
      dup
      length
      dup
      5 1 roll
      3 -1 roll
      add
      array cvx
      dup
      3 -1 roll
      0 exch
      putinterval
      dup
      4 2 roll
      putinterval
    } bind def

    /colorimage { % def
      pop pop     % remove 'false 3' operands
      {colortogray} mergeprocs
      image
    } bind def
  } ifelse          % end of 'false' case



524 568 8			% dimensions of data
[524 0 0 -568 0 568]		% mapping matrix
{currentfile pix readhexstring pop}
false 3 colorimage

