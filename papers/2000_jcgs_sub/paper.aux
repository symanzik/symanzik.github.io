\@writefile{toc}{\contentsline {section}{\numberline {1}Introduction}{1}}
\@writefile{toc}{\contentsline {section}{\numberline {2}Cartographic and Dynamic Statistical Graphics}{2}}
\@writefile{toc}{\contentsline {section}{\numberline {3}InterProcess Communication Standards and Remote Procedure Calls}{4}}
\@writefile{toc}{\contentsline {section}{\numberline {4}The Capabilities of the ArcView/XGobi Link}{5}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Linked Brushing between ArcView and XGobi}{6}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Example for the basic (or multivariate) link. The attribute data is displayed in XGobi (left) with a full complement of multivariate graphical tools available. This data is linked by brushing to the map view provided by ArcView (right). In the XGobi plot, two extremes on third quarter precipitation and elevation are painted as solid rectangles and they are shown to be located very close to one another in New Hampshire near the border with Maine in the ArcView map view.}}{7}}
\newlabel{ex_mult.ps}{{1}{7}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Two Motivational Examples}{8}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Example for the variogram--cloud link. In the upper left XGobi, we have brushed (using a solid rectangle) the highest values in the variogram--cloud plot ($g_{11} (\unhbox \voidb@x \hbox {\relax \mathversion  {bold}$s_i$}, \unhbox \voidb@x \hbox {\relax \mathversion  {bold}$s_j$})$) versus $d (\unhbox \voidb@x \hbox {\relax \mathversion  {bold}$s_i$}, \unhbox \voidb@x \hbox {\relax \mathversion  {bold}$s_j$})$). In the lower right ArcView map view, each pair of locations, related to a point that has been brushed in XGobi, has been connected by a line.}}{8}}
\newlabel{ex_vario.ps}{{2}{8}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Technical Implementation Details}{9}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}RPCs in the ArcView/XGobi Link}{9}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}XGobi Additions}{10}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {5.2.1}XGobi's RPC Structure}{10}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {5.2.2}Modifications to XGobi's Data Structures}{12}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Data Structures used for the Variogram--Cloud Link are {\it  Initial Data}, {\it  Binary Map}, {\it  Brushing List 1} and {\it  2}, and {\it  Array of Pairs}. In this example, we have $n = 3$ spatial locations and select a cutoff distance $d_{cut} = 1.1$. Numbers printed in bold ({\bf  1}, {\bf  2}, and {\bf  3}) relate to the initial data at spatial locations \relax \mathversion  {bold}$s_1$, \relax \mathversion  {bold}$s_2$, and \relax \mathversion  {bold}$s_3$ in ArcView. Numbers printed in italic ({\it  1} through {\it  7}) relate to points created for use in XGobi.}}{13}}
\newlabel{DataStructs}{{3}{13}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}ArcView 3.0 Modifications}{15}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The {\it  View} Document GUI in ArcView 3.0, used for all features of the link except the SCDF link. The following new features of the GUI have been added for the ArcView/XGobi link but are not part of the standard ArcView GUI. The red and green diamond buttons allow the user to start and stop XGobi. The paint brush button switches user control to brushing mode. The ``XGobi'' pulldown menu allows the user to select one of the features of the link. The ``Color'', ``Glyph'', and ``Size'' pulldown menus allow the user to select the plotting symbol.}}{16}}
\newlabel{GUI3.0.ps}{{4}{16}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Security and Concurrency}{17}}
