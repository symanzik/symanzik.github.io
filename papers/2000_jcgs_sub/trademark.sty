%**********************************************************************
% Ignore these set-up commands
%**********************************************************************
%\catcode`\@=11
% \tmfootnote{-text-}
% This command prints an unnumbered footnote
\long\def\@tmmakefntext#1{\parindent 1em #1}
\long\def\@tmfootnotetext#1{\insert\footins{\footnotesize
    \interlinepenalty\interfootnotelinepenalty 
    \splittopskip\footnotesep
    \splitmaxdepth \dp\strutbox \floatingpenalty \@MM
    \hsize\columnwidth \@parboxrestore
   \edef\@currentlabel{\csname p@footnote\endcsname}\@tmmakefntext
    {\rule{\z@}{\footnotesep}\ignorespaces
      #1\strut}}}
\def\tmfootnote{\@ifnextchar
    [{\@xfootnotenext}{\xdef\@thefnmark{\thempfn}\@tmfootnotetext}}
%\catcode`\@=12

% \Rcirc
% This command prints the registered trademark symbol, a capital R with a
% circle around it.
\def\Rcirc{\mbox{\small{\ooalign{\hfil\raise.07ex\hbox{\tiny R}\hfil\crcr\mathhexbox20D}}}}

%**********************************************************************
% Trademark commands  
%
%   \nameRfn  - produces `name' with a registered tradmark symbol ( R
%                with a circle around it) and the proper footnote
%
%   \nameTMfn - produces `name' with a tradmark symbol ( TM )
%                and the proper footnote
%
%   \nameR    - produces `name' with a registered tradmark symbol ( R
%                with a circle around it) without the footnote
%
%   \nameTM   - produces `name' with a tradmark symbol ( TM ) without
%                the footnote
%
% NOTE:  If the spacing after the name and symbol in the text is too
%        small, place a `\ ', that is backslash-blank, right after the
%        command, e.g., \nameTM\ .
%
%**********************************************************************

